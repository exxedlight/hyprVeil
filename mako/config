# Положение
anchor=top-right
margin=0,10,2,0

# Внешний вид
background-color=#21222C99
text-color=#ffffff
border-color=#343746
border-radius=5,15,5,15
border-size=1
padding=5
font=Symbols Nerd Font 10

# Поведение
default-timeout=3000
ignore-timeout=0
sort=-time
max-visible=10

# Группировка
# group-by=app-name

history=1
max-history=100
on-notify=exec canberra-gtk-play -f ~/Env/Sounds/notification.wav >/dev/null 2>&1 &



[app-name="silent-notify"]
on-notify=none
