{
    "custom/prev": {
        "format": "󰙣",
        "on-click": "playerctl previous",
        "tooltip-format": "Previous track",
        "min-length": 2
    },
    "custom/next": {
        "format": "󰙡",
        "on-click": "playerctl next",
        "tooltip-format": "Next track",
        "min-length": 2
    },
    "custom/volup":{
        "format": "",
        "on-click": "playerctl volume 0.05+"
    },
    "custom/voldown": {
        "format": "",
        "on-click": "playerctl volume 0.05-"
    },
    "custom/play-volume": {
        "exec": "echo \"  $(audtool get-volume)%\"",
        "interval": 1
    },
    "custom/play-count": {
        "exec": "~/.config/waybar/scripts/audacious-count.sh",
        "interval": 3
    }
}